# Production database connection used by `npm run sync:prod`.
#
# Copy this file to `.env.production` in the repository root and fill in the
# real credentials. `.env.production` is gitignored, so the live password is
# never committed. Only DATABASE_URL is required for a sync.
#
#   Copy-Item .env.production.example .env.production
#
# Notes:
# - Use the connection string your host provides, not "localhost" when the
#   database is remote or reached through a tunnel.
# - If the provider requires TLS, add ?sslmode=require to the query string.
# - The connection string needs the password percent-encoded if it contains
#   characters such as @ : / or #.

DATABASE_URL="postgresql://USER:PASSWORD@db.example.com:5432/expertise_wins?schema=public"