{
  "name": "expertise-wins-api",
  "version": "0.1.0",
  "description": "The Expertise Wins monorepo containing CLI engine, Express REST backend, and Next.js web application.",
  "main": "app.js",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,emerald\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run --prefix backend dev",
    "dev:frontend": "npm run --prefix frontend dev",
    "frontend": "npm run --prefix frontend dev",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,emerald\" \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "npm run --prefix backend start",
    "start:frontend": "npm run --prefix frontend start",
    "expertise": "npm run --prefix cli expertise",
    "settlement": "npm run --prefix cli settlement",
    "sync": "npm run --prefix cli sync",
    "sync:prod": "npm run --prefix cli sync:prod",
    "sync:dry": "npm run --prefix cli sync:dry",
    "expertise:sync": "npm run expertise && npm run sync",
    "settlement:sync": "npm run settlement && npm run sync"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "author": "",
  "license": "MIT"
}
